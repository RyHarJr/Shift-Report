# MySQL connection string
DATABASE_URL="mysql://root:your_password@localhost:3306/shift_report"

# Random secret (min 32 chars) for signing admin session tokens
AUTH_SECRET="replace-with-a-random-32-plus-character-secret-key"

# Default Admin account seeded by `npx prisma db seed`
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_NAME="Administrator QC"
ADMIN_DEFAULT_PASSWORD="Admin123!ChangeMe"

# Power Automate HTTP Trigger URLs for SharePoint image storage (server-only, keep secret)
UPLOAD_IMAGE="https://your-env.api.powerplatform.com/.../invoke?api-version=1&sp=...&sv=1.0&sig=REPLACE_ME"
GET_IMAGE="https://your-env.api.powerplatform.com/.../invoke?api-version=1&sp=...&sv=1.0&sig=REPLACE_ME"

